# WalletConnect Cloud project id (required for WalletConnect / MetaMask)
VITE_WC_PROJECT_ID=

# Optional: custom Sepolia RPC used by the renderer wallet provider.
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Optional: custom Sepolia RPC used by Electron main process health check.
SEPOLIA_RPC_URL=https://rpc.sepolia.org

