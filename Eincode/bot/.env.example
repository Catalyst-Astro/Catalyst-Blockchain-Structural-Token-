# ═══════════════════════════════════════════════════════════════
# Catalyst Threema Bot — Configuración
# Copia este archivo a .env y completa los valores
# ═══════════════════════════════════════════════════════════════

# ─── DeepSeek API (REQUERIDO) ──────────────────────────────────
DEEPSEEK_API_KEY=sk-tu-api-key-aqui
# Alternativa: AI_API_KEY (misma variable que Catalyst Chat)
# AI_API_KEY=sk-tu-api-key-aqui

# ─── Servidor ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── API Key (opcional — protege el endpoint REST) ────────────
CATALYST_API_KEY=tu-clave-secreta-api

# ─── Threema Gateway (opcional — para integración Threema) ─────
# Obtén tus credenciales en: https://gateway.threema.ch
THREEMA_ID=*TU_THREEMA_ID
THREEMA_SECRET=tu-threema-secret
THREEMA_PRIVATE_KEY=tu-llave-privada-en-hex
