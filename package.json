{
  "name": "catalyst-blockchain-structural-token",
  "version": "1.0.0",
  "description": "Hardhat setup for Catalyst structural token contracts",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "lint": "echo \"add eslint/solhint here\" && exit 0",
    "typecheck": "tsc -v >/dev/null 2>&1 || echo \"no tsconfig\"",
    "api:identity": "ts-node backend/api/server.ts",
    "gui:install": "node scripts/gui/install.js",
    "gui:up": "node scripts/gui/up.js",
    "gui:doctor": "node scripts/gui/doctor.js",
    "gui:dev": "npm --prefix apps/catalyst-gui run dev",
    "gui:build": "npm --prefix apps/catalyst-gui run build",
    "gui:test:smoke": "npm --prefix apps/catalyst-gui run test:smoke",
    "gui:artifacts": "npm --prefix apps/catalyst-gui run smoke:artifacts",
    "clockchain:validate": "node scripts/clockchain/validate-ntx.js",
    "clockchain:validate:ci": "node scripts/clockchain/validate-ntx.js --json-out artifacts/clockchain/traceability-summary.json --md-out artifacts/clockchain/traceability-summary.md",
    "git:branches:audit": "node scripts/git/report-remote-branches.js --write docs/ops/REMOTE_BRANCH_AUDIT.md"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.1",
    "@openzeppelin/contracts": "^4.9.6",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.5.2",
    "dotenv": "^17.2.2",
    "ethers": "^6.8.1",
    "hardhat": "^2.26.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "overrides": {
    "axios": "^1.12.0",
    "form-data": "^4.0.4",
    "cookie": "^0.7.0",
    "tmp": "^0.2.5",
    "undici": "^6.23.0"
  }
}
